# ARIA Environment Configuration
# Copy this file to .env and adjust variables as needed.

# Application
APP_NAME=ARIA
ENVIRONMENT=development
LOG_LEVEL=INFO

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=aria_db
MONGODB_TIMEOUT_MS=5000

# Cowrie Honeypot
COWRIE_LOG_PATH=honeypot/cowrie.json

# SDN Controller Configuration
SDN_CONTROLLER_IP=127.0.0.1
SDN_CONTROLLER_PORT=6653
SDN_SERVER_IP=10.0.0.10
SDN_HONEYPOT_IP=10.0.0.50
SDN_SUSPICIOUS_THRESHOLD=5
SDN_BACKEND_URL=http://localhost:8000/api/v1/sdn/telemetry
